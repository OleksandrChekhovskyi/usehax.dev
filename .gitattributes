* text=auto eol=lf

# Generated artifacts. The recording is machine-written JSON lines; the poster and the link
# preview card are rendered from it by tools/make-poster.sh. All are replaced wholesale
# rather than edited, so a line diff is noise. `binary` also keeps the recording byte-exact.
*.cast binary linguist-generated=true
demo-poster.png linguist-generated=true
demo-card.png linguist-generated=true

# Upstream asciinema-player build, committed so the page needs no build step or CDN.
# Not this project's code, and a minified bundle would otherwise decide the repository's
# reported language.
vendor/** linguist-vendored=true
